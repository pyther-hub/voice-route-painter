OPENAI_API_KEY=
SARVAM_API_KEY=
# optional: Groq models in the model switch (console.groq.com)
GROQ_API_KEY=
# optional: the agent's default model, an id from app/llm.py MODELS (default openai/gpt-5.4-nano;
# e.g. sarvam/gemma4). Users can switch in the top bar; only models whose API key is set are offered.
LLM_MODEL=
# optional: the frontier planner the agent escalates to (plan_with_frontier), an id from app/llm.py MODELS
# (default openai/gpt-5.4)
FRONTIER_MODEL=
# optional: text-to-speech voice (defaults bulbul:v3 / shubh)
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
# --- Product hygiene (app/guard.py); all optional, defaults are safe ---
# USD per day for the whole server / per browser tab; calls stop when used up
DAILY_BUDGET_USD=
SESSION_BUDGET_USD=
# frontier planner calls per browser tab (default 5) and per IP per hour (default 10)
FRONTIER_PER_SESSION=
FRONTIER_PER_IP_HOUR=
# secret for /trace.html and /api/trace (traces contain what users typed). Unset = local machine only
TRACE_KEY=
# 1 when behind a proxy (Fly, Render, Railway) so rate limits see the real visitor IP
TRUST_PROXY=
# extra sites allowed to open the WebSocket (comma separated); the site's own host is always allowed
ALLOWED_ORIGINS=
